---
/** GalleryGrid (komponenten.md §7) — Originalbilder ohne Referenzbehauptung. */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface GalleryItem {
  image: ImageMetadata;
  alt: string;
  caption?: string;
}

interface Props {
  title: string;
  id: string;
  items: GalleryItem[];
}

const { title, id, items } = Astro.props;
---

<section class="pf-section pf-section--sunken" aria-labelledby={id}>
  <div class="pf-container">
    <div class="pf-section-heading">
      <h2 id={id}>{title}</h2>
    </div>
    <ul class="pf-gallery" style="margin-top: var(--pf-space-7)">
      {
        items.map((item) => (
          <li>
            <figure>
              <Image
                src={item.image}
                alt={item.alt}
                widths={[400, 800]}
                sizes="(min-width: 1024px) 33vw, (min-width: 480px) 50vw, 100vw"
                loading="lazy"
                decoding="async"
              />
              {item.caption && <figcaption>{item.caption}</figcaption>}
            </figure>
          </li>
        ))
      }
    </ul>
  </div>
</section>
