{
  "name": "ivo-mertsch",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Relaunch ivo-mertsch.de — Astro (output: server) + selbst-gehostete Assets + Consent + Google-Bewertungen",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "prebuild": "node scripts/validate-content.mjs",
    "build": "astro build",
    "dev": "astro dev",
    "preview": "astro preview",
    "start": "node ./dist/server/entry.mjs",
    "typecheck": "astro check",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "contracts": "node tests/contracts/verify-contracts.cjs",
    "verify": "npm run build && npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.7",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "astro": "^7.3.8",
    "nodemailer": "^10.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.0.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.12.0",
    "eslint-plugin-astro": "^3.2.1",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  }
}
