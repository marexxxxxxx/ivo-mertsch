---
/** GalleryGrid (komponenten.md §7) — Originalbilder ohne Referenzbehauptung. */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import KiBildHinweis from "./KiBildHinweis.astro";

interface GalleryItem {
  image: ImageMetadata;
  alt: string;
  caption?: string;
}

interface Props {
  title: string;
  id: string;
  items: GalleryItem[];
}

const { title, id, items } = Astro.props;
---

<section class="pf-section pf-section--sunken" aria-labelledby={id}>
  <div class="pf-container">
    <div class="pf-section-heading">
      <h2 id={id}>{title}</h2>
    </div>
    <ul class="pf-gallery" style="margin-top: var(--pf-space-7)">
      {
        items.map((item, index) => (
          <li class={index === 0 ? "pf-gallery__item pf-gallery__item--big" : "pf-gallery__item"}>
            <figure>
              <Image
                src={item.image}
                alt={item.alt}
                widths={[400, 800]}
                sizes="(min-width: 1024px) 33vw, (min-width: 480px) 50vw, 100vw"
                loading="lazy"
                decoding="async"
              />
              {item.caption && <figcaption>{item.caption}</figcaption>}
            </figure>
          </li>
        ))
      }
    </ul>
    <!-- KI-Transparenz: Vollform im selben Landmark wie die Bildliste (ADR 0002 §5.1.1). -->
    <div class="pf-mt-7">
      <KiBildHinweis variant="full" />
    </div>
  </div>
</section>
