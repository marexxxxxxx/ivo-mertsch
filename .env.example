# =============================================================================
# .env.example — NUR Namen. Nie echte Werte eintragen.
# Quelle: MARAA-2 / ADR 0001 Abschnitt 8.4 und 8.5
#
# Regeln (aus dem ADR, verbindlich):
#   1. Diese Datei kopieren nach .env für lokale Entwicklung.
#   2. Echte Werte zur LAUFZEIT injizieren (docker run -e ...), nicht ins Image backen.
#   3. Kein GOOGLE_*_KEY und kein SMTP_PASS als Dockerfile-ARG — Build-ARGs
#      landen in der Image-History und sind damit exponiert.
#   4. .env ist git-ignored. Ein Commit mit einem echten Key ist ein Vorfall:
#      Key sofort rotieren.
# =============================================================================

# ---- Server ---------------------------------------------------------------
# Interne Ports. Keine Geheimnisse, aber umgebungsspezifisch.
PORT=4321
HOST=0.0.0.0

# ---- Google-Bewertungen (Quelle B, optional) ------------------------------
# Ohne diese Variablen laeuft die Seite im Modus REVIEWS_SOURCE=static_export
# und rendert den ehrlichen Leerzustand. Das ist der Default.
REVIEWS_SOURCE=static_export

# Places-API-Key — GEHEIM. Nur Laufzeit-Env, nie im Repo, nie im Issue,
# nie im Kommentar, nie im Log, nie im Screenshot.
GOOGLE_PLACES_API_KEY=

# Place ID des Eintrags, aus dem gelesen wird. Darf dauerhaft gespeichert
# werden (einzige Ausnahme in den Google-Caching-Regeln).
GOOGLE_PLACE_ID=

# Ziel des CTA "Jetzt bei Google bewerten" (Leerzustand der Bewertungs-Sektion).
# Standard ist der bestaetigte Google-Maps-Profil-Link aus content/site.json
# (reviews.cta_url, Kundenantwort 950f0d46 / OP-2 geklaert). Diese Env ist eine
# optionale Laufzeit-Uebersteuerung fuer abweichende Umgebungen; bleibt sie leer,
# gilt der statische Wert. Kein Abruf bei Google vor Consent.
GOOGLE_REVIEW_URL=

# Cache-TTL in Sekunden. Hart begrenzt auf 2592000 (30 Tage), weil Google
# temporaeres Caching zeitlich befristet zulaesst. Jeder groessere Wert ist
# ein Startup-Fehler.
REVIEWS_CACHE_TTL_S=3600

# Datei-Cache. Per Docker-Volume auslagern.
REVIEWS_CACHE_DIR=.cache

# ---- Kontaktformular (optional) -------------------------------------------
# Fehlt SMTP_HOST, rendert sich das Formular als mailto-Formular.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=

# GEHEIM. Nur Laufzeit-Env.
SMTP_PASS=

# Empfaenger der Kontaktanfragen. Die sichtbare Absenderadresse kommt aus
# content/site.json (kontakt.email, bestaetigt: info@ivo-mertsch.de); MAIL_TO
# wird zur LAUFZEIT auf dieselbe Adresse gesetzt. Kein Wert im Repo/Image.
MAIL_TO=

# ---- Anti-Spam ------------------------------------------------------------
CONTACT_MIN_FILL_SECONDS=3
CONTACT_RATE_LIMIT_MAX=5
CONTACT_RATE_LIMIT_WINDOW_S=600

# ---- Betrieb --------------------------------------------------------------
# Nur hinter einem Reverse Proxy, der X-Forwarded-For setzt, auf true setzen.
TRUST_PROXY=false
